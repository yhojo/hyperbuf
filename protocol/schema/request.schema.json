{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperbuf.invalid/protocol/request.schema.json",
  "title": "HyperBuf request",
  "description": "A request sent over the socket (one JSON Lines line). See docs/dev/integration-protocol.md §3. Unknown fields are ignored.",
  "type": "object",
  "required": ["op"],
  "properties": {
    "v": {
      "const": 1,
      "description": "Protocol version. 1 when omitted"
    },
    "id": {
      "type": ["string", "integer"],
      "description": "Identifier that pairs a response with its request"
    },
    "op": {
      "enum": ["ping", "open", "get-location", "get-view"]
    },
    "path": {
      "type": "string",
      "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\u007f]*\\.md$",
      "description": "Absolute path of the Markdown file to open (.md only, no .., no control characters)"
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "anchor": {
      "type": "string",
      "maxLength": 200
    },
    "project": {
      "type": "string"
    },
    "target": {
      "enum": ["current", "split-right", "split-below", "new-frame"]
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1
    }
  },
  "if": {
    "properties": {
      "op": {
        "const": "open"
      }
    }
  },
  "then": {
    "required": ["path"],
    "properties": {
      "path": {}
    }
  },
  "additionalProperties": true
}
