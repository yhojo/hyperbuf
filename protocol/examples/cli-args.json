[
  {
    "name": "Absolute path and line (file:line)",
    "files": ["docs/a.md"],
    "cwd": "${TMP}",
    "args": ["${TMP}/docs/a.md:12"],
    "request": {
      "op": "open",
      "path": "${TMP}/docs/a.md",
      "line": 12
    }
  },
  {
    "name": "Relative path (resolved from the cwd)",
    "files": ["docs/a.md"],
    "cwd": "${TMP}",
    "args": ["docs/a.md"],
    "request": {
      "op": "open",
      "path": "${TMP}/docs/a.md"
    }
  },
  {
    "name": "Relative path (. and .. resolved lexically)",
    "files": ["docs/a.md"],
    "cwd": "${TMP}/docs",
    "args": ["../docs/./a.md"],
    "request": {
      "op": "open",
      "path": "${TMP}/docs/a.md"
    }
  },
  {
    "name": "file:line:col (the column is ignored)",
    "files": ["docs/a.md"],
    "cwd": "${TMP}",
    "args": ["docs/a.md:12:5"],
    "request": {
      "op": "open",
      "path": "${TMP}/docs/a.md",
      "line": 12
    }
  },
  {
    "name": "--line",
    "files": ["docs/a.md"],
    "cwd": "${TMP}",
    "args": ["--line", "7", "docs/a.md"],
    "request": {
      "op": "open",
      "path": "${TMP}/docs/a.md",
      "line": 7
    }
  },
  {
    "name": "--anchor (Japanese)",
    "files": ["docs/a.md"],
    "cwd": "${TMP}",
    "args": ["--anchor", "参照履歴", "docs/a.md"],
    "request": {
      "op": "open",
      "path": "${TMP}/docs/a.md",
      "anchor": "参照履歴"
    }
  },
  {
    "name": "--target",
    "files": ["docs/a.md"],
    "cwd": "${TMP}",
    "args": ["--target", "split-right", "docs/a.md"],
    "request": {
      "op": "open",
      "path": "${TMP}/docs/a.md",
      "target": "split-right"
    }
  },
  {
    "name": "Japanese path and spaces",
    "files": ["文書/ハイパー バッファ.md"],
    "cwd": "${TMP}",
    "args": ["文書/ハイパー バッファ.md:3"],
    "request": {
      "op": "open",
      "path": "${TMP}/文書/ハイパー バッファ.md",
      "line": 3
    }
  },
  {
    "name": "After --, file names",
    "files": ["docs/a.md"],
    "cwd": "${TMP}",
    "args": ["--", "docs/a.md"],
    "request": {
      "op": "open",
      "path": "${TMP}/docs/a.md"
    }
  },
  {
    "name": "No arguments",
    "files": [],
    "cwd": "${TMP}",
    "args": [],
    "exit": 1
  },
  {
    "name": "Unknown option",
    "files": ["docs/a.md"],
    "cwd": "${TMP}",
    "args": ["--nope", "docs/a.md"],
    "exit": 1
  },
  {
    "name": "--line is 0",
    "files": ["docs/a.md"],
    "cwd": "${TMP}",
    "args": ["--line", "0", "docs/a.md"],
    "exit": 1
  },
  {
    "name": "--line has no value",
    "files": ["docs/a.md"],
    "cwd": "${TMP}",
    "args": ["docs/a.md", "--line"],
    "exit": 1
  },
  {
    "name": "--target is invalid",
    "files": ["docs/a.md"],
    "cwd": "${TMP}",
    "args": ["--target", "bogus", "docs/a.md"],
    "exit": 1
  },
  {
    "name": "--line with several files",
    "files": ["docs/a.md", "docs/b.md"],
    "cwd": "${TMP}",
    "args": ["--line", "3", "docs/a.md", "docs/b.md"],
    "exit": 1
  },
  {
    "name": "File does not exist",
    "files": [],
    "cwd": "${TMP}",
    "args": ["docs/missing.md"],
    "exit": 2
  },
  {
    "name": "Not .md",
    "files": ["docs/a.txt"],
    "cwd": "${TMP}",
    "args": ["docs/a.txt"],
    "exit": 2
  },
  {
    "name": "Directory",
    "files": ["docs/a.md"],
    "cwd": "${TMP}",
    "args": ["docs"],
    "exit": 2
  }
]
