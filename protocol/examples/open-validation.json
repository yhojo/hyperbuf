[
  {
    "name": "Minimal open",
    "request": {
      "op": "open",
      "path": "/Users/me/docs/design.md"
    },
    "expect": "ok"
  },
  {
    "name": "With line and v",
    "request": {
      "v": 1,
      "id": "1",
      "op": "open",
      "path": "/Users/me/docs/design.md",
      "line": 120
    },
    "expect": "ok"
  },
  {
    "name": "With an anchor (Japanese)",
    "request": {
      "op": "open",
      "path": "/Users/me/docs/design.md",
      "anchor": "参照履歴"
    },
    "expect": "ok"
  },
  {
    "name": "Japanese path",
    "request": {
      "op": "open",
      "path": "/Users/me/文書/ハイパーバッファ.md"
    },
    "expect": "ok"
  },
  {
    "name": "Path with spaces",
    "request": {
      "op": "open",
      "path": "/Users/me/My Docs/a b.md"
    },
    "expect": "ok"
  },
  {
    "name": "Unknown fields are ignored",
    "request": {
      "op": "open",
      "path": "/Users/me/docs/design.md",
      "future": {
        "x": 1
      }
    },
    "expect": "ok"
  },
  {
    "name": "id may be a number",
    "request": {
      "op": "open",
      "id": 7,
      "path": "/Users/me/docs/design.md"
    },
    "expect": "ok"
  },
  {
    "name": "Relative path",
    "request": {
      "op": "open",
      "path": "docs/a.md"
    },
    "expect": "bad-request"
  },
  {
    "name": "No path",
    "request": {
      "op": "open"
    },
    "expect": "bad-request"
  },
  {
    "name": "Contains ..",
    "request": {
      "op": "open",
      "path": "/Users/me/../x/a.md"
    },
    "expect": "bad-request"
  },
  {
    "name": "Ends with ..",
    "request": {
      "op": "open",
      "path": "/Users/me/.."
    },
    "expect": "bad-request"
  },
  {
    "name": "Allowed when .. is only part of a name",
    "request": {
      "op": "open",
      "path": "/Users/me/a..b.md"
    },
    "expect": "ok"
  },
  {
    "name": "Control character (newline)",
    "request": {
      "op": "open",
      "path": "/Users/me/a\nb.md"
    },
    "expect": "bad-request"
  },
  {
    "name": "NUL",
    "request": {
      "op": "open",
      "path": "/Users/me/a\u0000b.md"
    },
    "expect": "bad-request"
  },
  {
    "name": "Not .md",
    "request": {
      "op": "open",
      "path": "/etc/passwd"
    },
    "expect": "not-markdown"
  },
  {
    "name": ".md.txt",
    "request": {
      "op": "open",
      "path": "/Users/me/a.md.txt"
    },
    "expect": "not-markdown"
  },
  {
    "name": "line is 0",
    "request": {
      "op": "open",
      "path": "/Users/me/docs/design.md",
      "line": 0
    },
    "expect": "bad-request"
  },
  {
    "name": "line is negative",
    "request": {
      "op": "open",
      "path": "/Users/me/docs/design.md",
      "line": -3
    },
    "expect": "bad-request"
  },
  {
    "name": "anchor of 200 characters",
    "request": {
      "op": "open",
      "path": "/Users/me/docs/design.md",
      "anchor": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "expect": "ok"
  },
  {
    "name": "anchor of 201 characters",
    "request": {
      "op": "open",
      "path": "/Users/me/docs/design.md",
      "anchor": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "expect": "bad-request"
  },
  {
    "name": "Unsupported version",
    "request": {
      "v": 2,
      "op": "open",
      "path": "/Users/me/docs/design.md"
    },
    "expect": "unsupported-version"
  }
]
