[
  {
    "name": "絶対パスと行(file:line)",
    "files": ["docs/a.md"],
    "cwd": "${TMP}",
    "args": ["${TMP}/docs/a.md:12"],
    "request": {
      "op": "open",
      "path": "${TMP}/docs/a.md",
      "line": 12
    }
  },
  {
    "name": "相対パス(cwd から解決)",
    "files": ["docs/a.md"],
    "cwd": "${TMP}",
    "args": ["docs/a.md"],
    "request": {
      "op": "open",
      "path": "${TMP}/docs/a.md"
    }
  },
  {
    "name": "相対パス(. と .. を字句的に解決)",
    "files": ["docs/a.md"],
    "cwd": "${TMP}/docs",
    "args": ["../docs/./a.md"],
    "request": {
      "op": "open",
      "path": "${TMP}/docs/a.md"
    }
  },
  {
    "name": "file:line:col(桁は無視)",
    "files": ["docs/a.md"],
    "cwd": "${TMP}",
    "args": ["docs/a.md:12:5"],
    "request": {
      "op": "open",
      "path": "${TMP}/docs/a.md",
      "line": 12
    }
  },
  {
    "name": "--line",
    "files": ["docs/a.md"],
    "cwd": "${TMP}",
    "args": ["--line", "7", "docs/a.md"],
    "request": {
      "op": "open",
      "path": "${TMP}/docs/a.md",
      "line": 7
    }
  },
  {
    "name": "--anchor(日本語)",
    "files": ["docs/a.md"],
    "cwd": "${TMP}",
    "args": ["--anchor", "参照履歴", "docs/a.md"],
    "request": {
      "op": "open",
      "path": "${TMP}/docs/a.md",
      "anchor": "参照履歴"
    }
  },
  {
    "name": "--project と --target",
    "files": ["docs/a.md"],
    "cwd": "${TMP}",
    "args": ["--project", "${TMP}", "--target", "split-right", "docs/a.md"],
    "request": {
      "op": "open",
      "path": "${TMP}/docs/a.md",
      "project": "${TMP}",
      "target": "split-right"
    }
  },
  {
    "name": "日本語のパスとスペース",
    "files": ["文書/ハイパー バッファ.md"],
    "cwd": "${TMP}",
    "args": ["文書/ハイパー バッファ.md:3"],
    "request": {
      "op": "open",
      "path": "${TMP}/文書/ハイパー バッファ.md",
      "line": 3
    }
  },
  {
    "name": "-- のあとは、ファイル名",
    "files": ["docs/a.md"],
    "cwd": "${TMP}",
    "args": ["--", "docs/a.md"],
    "request": {
      "op": "open",
      "path": "${TMP}/docs/a.md"
    }
  },
  {
    "name": "引数なし",
    "files": [],
    "cwd": "${TMP}",
    "args": [],
    "exit": 1
  },
  {
    "name": "未知のオプション",
    "files": ["docs/a.md"],
    "cwd": "${TMP}",
    "args": ["--nope", "docs/a.md"],
    "exit": 1
  },
  {
    "name": "--line が 0",
    "files": ["docs/a.md"],
    "cwd": "${TMP}",
    "args": ["--line", "0", "docs/a.md"],
    "exit": 1
  },
  {
    "name": "--line に値がない",
    "files": ["docs/a.md"],
    "cwd": "${TMP}",
    "args": ["docs/a.md", "--line"],
    "exit": 1
  },
  {
    "name": "--target が不正",
    "files": ["docs/a.md"],
    "cwd": "${TMP}",
    "args": ["--target", "bogus", "docs/a.md"],
    "exit": 1
  },
  {
    "name": "複数ファイルに --line",
    "files": ["docs/a.md", "docs/b.md"],
    "cwd": "${TMP}",
    "args": ["--line", "3", "docs/a.md", "docs/b.md"],
    "exit": 1
  },
  {
    "name": "ファイルがない",
    "files": [],
    "cwd": "${TMP}",
    "args": ["docs/missing.md"],
    "exit": 2
  },
  {
    "name": ".md 以外",
    "files": ["docs/a.txt"],
    "cwd": "${TMP}",
    "args": ["docs/a.txt"],
    "exit": 2
  },
  {
    "name": "ディレクトリ",
    "files": ["docs/a.md"],
    "cwd": "${TMP}",
    "args": ["docs"],
    "exit": 2
  }
]
