{
  "name": "@hyperbuf/core",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "HyperBuf の共通 Web コア(OS 非依存)。シェルとの境界は HyperbufHost の契約のみ。",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node build.mjs",
    "check": "npm run typecheck && npm run format:check && npm test && node scripts/gen-keybindings.ts --check && node scripts/gen-languages.ts --check && node scripts/licenses.mjs check",
    "licenses": "node scripts/licenses.mjs summary",
    "dev": "npm run build && node scripts/dev-server.mjs",
    "keybindings": "node scripts/gen-keybindings.ts",
    "languages": "node scripts/gen-languages.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.4",
    "@wooorm/starry-night": "^3.11.0",
    "esbuild": "^0.28.2",
    "github-markdown-css": "^5.9.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "katex": "^0.19.0",
    "mermaid": "^12.1.0",
    "prettier": "^3.9.9",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vscode-oniguruma": "^2.0.1"
  }
}
